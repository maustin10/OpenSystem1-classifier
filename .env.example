# Copy to .env and fill in. Never commit .env.
#
# TypeSafe System One API key, used by poc/typesafe_decision_poc.py.
# The script accepts either name; TYPESAFE_API is what the main repo uses.
TYPESAFE_API=apikey-...

# Only needed behind a TLS-intercepting corporate proxy. Build the bundle with:
#   python3 -c "import certifi;print(certifi.where())"   # copy this file, then append:
#   security find-certificate -a -p /Library/Keychains/System.keychain >> bundle.pem
# SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
